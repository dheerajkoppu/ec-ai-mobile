{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "node", // ✅ tell TS to use Node resolution rules
    "moduleSuffixes": [         // ✅ allow platform-specific files
      ".native",
      ".ios",
      ".android",
      ".web",
      ""
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
