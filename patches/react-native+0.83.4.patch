   if (!shouldReplaceRnCoreConfiguration(configuration)) {
+    ensureUseFrameworksModulemap();
     return;
   }
 
   replaceRNCoreConfiguration(configuration, version, podsRoot);
   updateLastBuildConfiguration(configuration);
