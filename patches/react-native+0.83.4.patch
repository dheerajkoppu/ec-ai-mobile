+// Recreates React-use-frameworks.modulemap after the React-Core-prebuilt directory
+// is replaced. This file is created by expo-modules-autolinking during pod install
+// for use_frameworks! compatibility, but gets deleted when [RNDeps] replaces the dir.
+function ensureUseFrameworksModulemap() {
+  const modulemapPath = path.join('React-Core-prebuilt', 'React-use-frameworks.modulemap');
+  if (!fs.existsSync(modulemapPath)) {
+    const content = [
+      'module React {',
+      '  umbrella header "React.xcframework/Headers/React_Core/React_Core-umbrella.h"',
+      '  export *',
+      '}',
+      '',
+    ].join('\n');
+    fs.writeFileSync(modulemapPath, content);
+    console.log('Created React-use-frameworks.modulemap for use_frameworks! compatibility');
+  }
+}
+
 function main(
   configuration /*: string */,
   version /*: string */,
@@ -140,11 +158,13 @@ function main(
