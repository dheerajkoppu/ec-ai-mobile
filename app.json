{
  "expo": {
    "name": "EC-AI",
    "slug": "ec-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dheerajkoppu.ec-ai",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "EC-AI"
      },
      "icon": {
        "light": "./assets/images/logo.png",
        "dark": "./assets/images/ios-dark.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#F5F6F9"
      },
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://ec-ai.expo.app"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "We need access to your photos so you can choose a profile picture."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#F5F7FA",
          "dark": {
            "image": "./assets/images/splash.png",
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "API_ORIGIN": "https://ec-ai--tzxxglromv.expo.app",
      "eas": {
        "projectId": "a31952ea-e220-4629-8d9e-7efbbb3c8b30"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a31952ea-e220-4629-8d9e-7efbbb3c8b30"
    }
  }
}
