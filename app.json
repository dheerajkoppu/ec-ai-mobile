{
  "expo": {
    "name": "EC-AI",
    "slug": "ec-ai",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "ec-ai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dheerajkoppu.ec-ai",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "EC-AI",
        "NSUserTrackingUsageDescription": "This identifier will be used to deliver personalized ads to you."
      },
      "icon": {
        "light": "./assets/images/logo.png",
        "dark": "./assets/images/ios-dark.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#F5F7FA"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://ec-ai.expo.app"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "We need access to your photos so you can choose a profile picture."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "imageWidth": 300,
          "backgroundColor": "#F5F7FA",
          "dark": {
            "image": "./assets/images/splash.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-video",
      [
        "expo-build-properties",
